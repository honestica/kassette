#!/bin/bash

set -e
set -u
set -o pipefail

cd "$(dirname "$0")/.."

version=$(python3 -c 'import tomllib; print(tomllib.load(open("pyproject.toml", "rb"))["project"]["version"])')
tag="v${version}"

branch=$(git rev-parse --abbrev-ref HEAD)
if [ "${branch}" != "master" ]; then
  echo "Must be run from master (currently on ${branch})" >&2
  exit 1
fi

if ! git diff --quiet HEAD; then
  echo "Tracked files have uncommitted changes" >&2
  exit 1
fi

git fetch --quiet origin master
if [ "$(git rev-parse HEAD)" != "$(git rev-parse origin/master)" ]; then
  echo "master is not in sync with origin/master" >&2
  exit 1
fi

if git ls-remote --exit-code --tags origin "refs/tags/${tag}" >/dev/null; then
  echo "Tag ${tag} already exists on origin" >&2
  exit 1
fi

if git rev-parse --quiet --verify "refs/tags/${tag}" >/dev/null; then
  if [ "$(git rev-parse "${tag}^{commit}")" != "$(git rev-parse HEAD)" ]; then
    echo "Local tag ${tag} exists but does not point to HEAD" >&2
    exit 1
  fi
  echo "Local tag ${tag} already exists on HEAD, reusing it"
else
  git tag -s -m "${tag}" "${tag}"
fi

read -r -p "Push ${tag} to origin and trigger the PyPI release? [y/N] " answer
if [ "${answer}" != "y" ]; then
  echo "Aborted, ${tag} was not pushed"
  exit 1
fi

git push origin "refs/tags/${tag}"
